# Copy this file to .env only if a script in this repo asks for it.
# Never put real values in a committed file.
# These are placeholders. Replace each one at run time, in your terminal.
WIN11_IMAGE_NAME="Windows 11 Pro"
WIN11_LANG="en-us"
WIN11_USERNAME="YOUR_WINDOWS_USERNAME"
# WIN11_PASSWORD is intentionally NOT set here.
# The installer script prompts for it securely if it is unset.
WIN11_RDP_PORT="3389"
AWS_INSTANCE_ID="i-xxxxxxxxxxxxxxxxx"
AWS_AMI_ID="ami-xxxxxxxxxxxxxxxxx"
AWS_REGION="YOUR_AWS_REGION"
